import("//build/boards/${board}.gni")
import("//build/templates/reload_autoconf_and_build.gni")
import("//build/templates/rust.gni")
import("//build/toolchain/blueos.gni")

_slint_ui_generated = "${target_gen_dir}/slint_ui_main_window.rs"

action("generate_slint_ui") {
  script = "//build/scripts/run_slint_cli.py"
  slint_entry = "ui/main.slint"
  inputs = [
    slint_entry,
    "ui/components/app-page.slint",
    "ui/components/demo-icon.slint",
    "ui/components/gesture-layer.slint",
    "ui/components/icons.slint",
    "ui/components/nav-tab.slint",
    "ui/components/theme.slint",
    "ui/launcher/launcher.slint",
    "ui/pages/touch-page.slint",
    "ui/pages/brightness-page.slint",
    "ui/pages/demo-page.slint",
    "ui/pages/sched-mon-page.slint",
    "ui/pages/screen-color-page.slint",
    "ui/pages/sd-card-page.slint",
    "ui/pages/text-viewer.slint",
    "ui/pages/image-viewer.slint",
    "ui/pages/audio-viewer.slint",
    "ui/pages/imu-page.slint",
    "ui/pages/battery-page.slint",
    "ui/pages/file-io-page.slint",
    "ui/pages/audio-page.slint",
    "ui/pages/power-page.slint",
    "resources/website-text.ttf",
    "resources/website-glyphs.slint",
    "resources/blueos-icons.ttf",
  ]
  outputs = [ _slint_ui_generated ]
  args = [
    "--embed-resources",
    "software-renderer",
    "-I",
    rebase_path("."),
    "--output",
    rebase_path(_slint_ui_generated),
    rebase_path(slint_entry),
  ]
}

reload_autoconf_and_build("slint_ui_example") {
  app_conf = [ "app.conf" ]
  crate_name = "slint_ui_example"
  crate_type = "bin"

  sources = [ "src/main.rs" ]
  inputs = [
    _slint_ui_generated,
    "resources/background_480x480.rgb565",
    "src/brightness.rs",
    "src/battery.rs",
    "src/flash_io.rs",
    "src/png_view.rs",
    "src/sched_mon.rs",
    "src/sdcard.rs",
    "src/imu.rs",
    "src/keys.rs",
    "src/audio.rs",
    "src/audio_pcm_short.rs",
    "src/text_pages.rs",
    "resources/text-metrics.rs",
  ]
  rustenv = [ "SLINT_UI_GENERATED=" + rebase_path(_slint_ui_generated) ]
  deps = [
    ":generate_slint_ui",
    "//external/vendor/libm-0.2.16:libm",
    "//external/vendor/png-0.18.1:png",
    "//external/vendor/slint-1.17.1:slint",
    "//kernel/kconfig:blueos_kconfig",
    "//kernel/rsrt:rsrt_std",
    "//libc",
    "//librs",
  ]
  linker_script = default_linker_script
  configs = [ "//build/boards/${board}:kernel_config" ]

  # Flash access, reset and delay routines live in the chip ROM linker map.
  # This is board support, not the Wi-Fi driver; keep only this minimal native
  # link input now that the ESP radio archives are no longer used.
  if (board == "esp32c6_devkitc_1") {
    rom_lib_dir = "//external/vendor/esp-rom-sys-0.1.4/ld/esp32c6"
  } else {
    rom_lib_dir = "//external/vendor/esp-rom-sys-0.1.4/ld/esp32c3"
  }
  rustflags = [
    "-Clink-arg=-L" + rebase_path(rom_lib_dir),
    "-Clink-arg=-lesp_rom_sys",
  ]
}
