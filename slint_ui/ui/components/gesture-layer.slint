// Reusable full-screen gesture layer that detects swipe directions.
// Compatible with SoftwareRenderer::render_by_line: no Path items.
// Pages embed this behind their content so buttons and other TouchAreas
// receive events first (Slint routes to the z-topmost TouchArea).

import { Theme } from "theme.slint";

export component GestureLayer inherits Rectangle {
    callback swipe-left(float, float);
    callback swipe-right(float, float);
    callback swipe-up(float, float);
    callback swipe-down(float, float);
    callback tap(float, float);
    callback press(float, float);
    callback release();
    callback debug(string);
    in property <bool> enabled: true;

    background: transparent;

    gesture-area := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        property <length> start-x: 0;
        property <length> start-y: 0;
        property <bool> tracking: false;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                // Bottom nav bar (y >= 424) and title bar (y < 60) are handled
                // by their own TouchAreas. Ignore presses there so the buttons
                // receive clean down→up sequences and clicked fires reliably.
                // Only the down event is filtered: a swipe that ends over the
                // nav bar must still dispatch its up so the gesture completes.
                if self.mouse-y >= 424px || self.mouse-y < 60px {
                    return;
                }
                self.start-x = self.mouse-x;
                self.start-y = self.mouse-y;
                self.tracking = true;
                root.press(self.mouse-x / 1px, self.mouse-y / 1px);
            }
            if event.kind == PointerEventKind.move && self.tracking {
                // no per-move logging: too chatty for the serial console
            }
            if event.kind == PointerEventKind.up && self.tracking {
                let dx = self.mouse-x - self.start-x;
                let dy = self.mouse-y - self.start-y;
                let abs-dx = dx < 0px ? -dx : dx;
                let abs-dy = dy < 0px ? -dy : dy;

                if abs-dx >= 20px || abs-dy >= 20px {
                    // Require horizontal motion to be clearly dominant (>= 2× vertical)
                    // so an upward swipe with a slight lateral drift is not mistaken
                    // for a sideways swipe.
                    if abs-dx >= abs-dy * 2 {
                        if dx < 0px { root.swipe-left(dx / 1px, dy / 1px); }
                        if dx > 0px { root.swipe-right(dx / 1px, dy / 1px); }
                    } else {
                        if dy < 0px { root.swipe-up(dx / 1px, dy / 1px); }
                        if dy > 0px { root.swipe-down(dx / 1px, dy / 1px); }
                    }
                } else {
                    root.tap(self.mouse-x / 1px, self.mouse-y / 1px);
                }
                root.release();
                self.tracking = false;
            }
        }
    }
}