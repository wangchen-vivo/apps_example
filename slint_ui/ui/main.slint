// Main entry point for the Slint UI example.
// Imports all page components and assembles the MainWindow.
// Compatible with SoftwareRenderer::render_by_line: no Path items.

import { Launcher } from "./launcher/launcher.slint";
import { Theme } from "./components/theme.slint";
import { BatteryPage } from "./pages/battery-page.slint";
import { BrightnessPage } from "./pages/brightness-page.slint";
import { DemoPage } from "./pages/demo-page.slint";
import { SchedMonPage } from "./pages/sched-mon-page.slint";
import { ScreenColorPage } from "./pages/screen-color-page.slint";
import { SdCardPage, SdFileEntry } from "./pages/sd-card-page.slint";
import { WifiScanPage, WifiNetwork } from "./pages/wifi-scan-page.slint";
import { ImuPage } from "./pages/imu-page.slint";
import { FileIoPage } from "./pages/file-io-page.slint";
import { MetalsPage } from "./pages/metals-page.slint";
import { TouchPage } from "./pages/touch-page.slint";
import { AudioPage } from "./pages/audio-page.slint";
import { PowerPage } from "./pages/power-page.slint";
import "../resources/website-text.ttf";
import "../resources/blueos-icons.ttf";
import { WebsiteGlyphs } from "../resources/website-glyphs.slint";

export component MainWindow inherits Window {
    width: 480px;
    height: 480px;
    background: transparent;
    default-font-family: Theme.text-font-family;
    default-font-size: 11px;

    in-out property <int> current-app: -1;  // -1 = launcher, 6+ = app pages
    property <int> current-tab: 0;   // 0 = 内核, 1 = 外设
    property <float> tab-offset: 0.0;
    callback app-changed(int);

    in property <[WifiNetwork]> networks;
    in-out property <bool> scanning: false;
    in-out property <int> result-count: 0;
    in-out property <int> wifi-current-page: 0;
    in-out property <int> wifi-total-pages: 0;
    in-out property <string> status-text: "正在准备无线扫描";
    callback scan-requested();
    callback wifi-page-active-changed(bool);
    callback wifi-scroll-up();
    callback wifi-scroll-down();
    callback debug(string);

    in-out property <int> battery-percent: 0;
    in-out property <string> battery-voltage: "--.--- V";
    in-out property <string> battery-state: "正在读取";
    in-out property <string> battery-status: "打开页面以读取电池";
    in-out property <bool> battery-available: false;
    callback battery-active-changed(bool);

    in-out property <bool> flash-running: false;
    in-out property <int> flash-bytes-written: 0;
    in-out property <int> flash-total-bytes: 0;
    in-out property <int> flash-speed-kbps: 0;
    in-out property <int> flash-average-kbps: 0;
    in-out property <int> flash-slot: 0;
    in-out property <int> flash-sequence: 0;
    in-out property <string> flash-status-text: "点按 START 写入并校验 Flash";
    callback flash-start-requested();
    callback flash-page-active-changed(bool);

    // Gold & silver price page (metals.rs drives these).
    in-out property <string> metals-time: "--:--";
    in-out property <string> metals-xau: "--";
    in-out property <string> metals-xag: "--";
    in-out property <string> metals-status: "…";
    in-out property <bool> metals-refreshing: false;
    callback metals-refresh();
    callback metals-active-changed(bool);

    in-out property <int> brightness: 100;
    callback set-brightness(int);
    callback commit-brightness(int);
    callback brightness-page-active-changed(bool);

    // SchedMon page properties
    in property <int> cpu-cores: 1;
    in property <[float]> cpu-usage-percent;
    in property <string> cpu-model: "esp32c6";
    in property <string> cpu-isa: "rv32imac";
    in property <string> cpu-mhz-text: "160 MHz";
    in property <float> mem-total-kb: 0.0;
    in property <float> mem-used-kb: 0.0;
    in property <float> mem-max-used-kb: 0.0;
    in property <int> task-hidden: 0;
    in property <int> task-total: 0;
    in property <int> task-page: 1;
    in property <int> task-page-count: 1;
    in property <string> task-col-tid: "";
    in property <string> task-col-type: "";
    in property <string> task-col-state: "";
    in property <string> task-col-prio: "";
    in property <string> task-col-name: "";
    callback refresh-tasks();
    callback task-scroll-up();
    callback task-scroll-down();
    callback sched-mon-active-changed(bool);

    in-out property <string> accel-x: "---";
    in-out property <string> accel-y: "---";
    in-out property <string> accel-z: "---";
    in-out property <string> gyro-x: "---";
    in-out property <string> gyro-y: "---";
    in-out property <string> gyro-z: "---";
    callback imu-page-active-changed(bool);

    in property <[SdFileEntry]> sd-entries;
    in-out property <string> sd-path-text: "/data";
    in-out property <string> sd-status-text: "打开页面以读取 SD 卡";
    in-out property <int> sd-total-count: 0;
    in-out property <int> sd-total-pages: 0;
    in-out property <int> sd-current-page: 0;
    in-out property <int> sd-visible-count: 0;
    in-out property <int> sd-scroll-offset: 0;
    in-out property <bool> sd-read-error: false;
    in-out property <bool> sd-text-open: false;
    in-out property <string> sd-text-title: "";
    // Seed the software renderer with glyphs needed by dynamic SD-card text.
    in-out property <string> sd-text-content: WebsiteGlyphs.characters;
    in-out property <string> sd-text-page: "";
    in-out property <bool> sd-text-has-previous: false;
    in-out property <bool> sd-text-has-next: false;
    in-out property <bool> sd-image-open: false;
    in-out property <string> sd-image-title: "";
    in-out property <string> sd-image-status: "";
    in-out property <bool> sd-audio-open: false;
    in-out property <string> sd-audio-title: "";
    in-out property <string> sd-audio-size: "";
    in-out property <string> sd-audio-status: "";
    in-out property <bool> sd-audio-playing: false;
    // Audio page properties
    in-out property <string> audio-status: "点击播放";
    in-out property <bool> audio-playing: false;
    in-out property <int> audio-volume: 100;
    in-out property <bool> audio-has-sd-audio: false;
    in-out property <string> audio-track-title: "";
    in-out property <int> audio-track-index: 0;
    in-out property <int> audio-track-count: 0;
    callback audio-play();
    callback audio-stop();
    callback audio-prev();
    callback audio-next();
    callback set-audio-volume(int);
    callback audio-page-active-changed(bool);
    callback power-off();
    callback reboot();
    callback sd-page-active-changed(bool);
    callback sd-entry-selected(int);
    callback sd-up-requested();
    callback sd-refresh-requested();
    callback sd-scroll-up();
    callback sd-scroll-down();
    callback sd-close-text();
    callback sd-previous-text-page();
    callback sd-next-text-page();
    callback sd-close-image();
    callback sd-close-audio();

    changed current-app => {
        root.app-changed(root.current-app);
        root.sched-mon-active-changed(root.current-app == 6);
        root.battery-active-changed(root.current-app == 7);
        root.wifi-page-active-changed(root.current-app == 11);
        root.imu-page-active-changed(root.current-app == 12);
        root.sd-page-active-changed(root.current-app == 13);
        root.brightness-page-active-changed(root.current-app == 10);
        root.metals-active-changed(root.current-app == 14);
        root.audio-page-active-changed(root.current-app == 15);
        root.flash-page-active-changed(root.current-app == 8);
        if root.current-app != 13 {
            if root.sd-image-open {
                root.sd-close-image();
            }
            if root.sd-audio-open {
                root.sd-close-audio();
            }
            if root.sd-text-open {
                root.sd-close-text();
            }
        }
    }

    // Launcher
    if current-app == -1: Launcher {
        current-tab <=> root.current-tab;
        tab-offset <=> root.tab-offset;
        open-app(app-id) => { root.current-app = app-id; }
        swipe-left(dx, dy) => { if root.current-tab < 1 { root.current-tab = 1; root.tab-offset = 1.0; } }
        swipe-right(dx, dy) => { if root.current-tab > 0 { root.current-tab = 0; root.tab-offset = 0.0; } }
    }

    // App pages — all inherit AppPage which provides swipe-left/right/up/down callbacks.
    // Each page binds swipe-right to go-back() for consistent nav.
    if current-app == 6: SchedMonPage {
        cpu-cores <=> root.cpu-cores;
        cpu-usage-percent <=> root.cpu-usage-percent;
        cpu-model <=> root.cpu-model;
        cpu-isa <=> root.cpu-isa;
        cpu-mhz-text <=> root.cpu-mhz-text;
        mem-total-kb <=> root.mem-total-kb;
        mem-used-kb <=> root.mem-used-kb;
        mem-max-used-kb <=> root.mem-max-used-kb;
        task-hidden <=> root.task-hidden;
        task-total <=> root.task-total;
        task-page <=> root.task-page;
        task-page-count <=> root.task-page-count;
        task-col-tid <=> root.task-col-tid;
        task-col-type <=> root.task-col-type;
        task-col-state <=> root.task-col-state;
        task-col-prio <=> root.task-col-prio;
        task-col-name <=> root.task-col-name;
        refresh-tasks => { root.refresh-tasks(); }
        swipe-up(dx, dy) => { root.task-scroll-up(); }
        swipe-down(dx, dy) => { root.task-scroll-down(); }
        swipe-right(dx, dy) => { root.current-app = -1; }
        go-back => { root.current-app = -1; } go-home => { root.current-app = -1; }
    }
    if current-app == 7: BatteryPage {
        percent: root.battery-percent;
        voltage: root.battery-voltage;
        charging-state: root.battery-state;
        status-text: root.battery-status;
        available: root.battery-available;
        swipe-right(dx, dy) => { root.current-app = -1; }
        go-back => { root.current-app = -1; }
        go-home => { root.current-app = -1; }
    }
    if current-app == 8: FileIoPage {
        running <=> root.flash-running;
        bytes-written <=> root.flash-bytes-written;
        total-bytes <=> root.flash-total-bytes;
        speed-kbps <=> root.flash-speed-kbps;
        average-kbps <=> root.flash-average-kbps;
        slot <=> root.flash-slot;
        sequence <=> root.flash-sequence;
        status-text <=> root.flash-status-text;
        start-requested => { root.flash-start-requested(); }
        swipe-right(dx, dy) => { root.current-app = -1; }
        go-back => { root.current-app = -1; }
        go-home => { root.current-app = -1; }
    }
    if current-app == 9: ScreenColorPage { swipe-right(dx, dy) => { root.current-app = -1; } go-back => { root.current-app = -1; } go-home => { root.current-app = -1; } }
    if current-app == 10: BrightnessPage {
        brightness <=> root.brightness;
        set-brightness(value) => { root.set-brightness(value); }
        commit-brightness(value) => { root.commit-brightness(value); }
        swipe-right(dx, dy) => { root.current-app = -1; }
        swipe-up(dx, dy) => { root.brightness = min(root.brightness + 10, 100); root.set-brightness(root.brightness); root.commit-brightness(root.brightness); }
        swipe-down(dx, dy) => { root.brightness = max(root.brightness - 10, 30); root.set-brightness(root.brightness); root.commit-brightness(root.brightness); }
        go-back => { root.current-app = -1; } go-home => { root.current-app = -1; }
    }
    // 外设 demo pages
    if current-app == 11: WifiScanPage {
        networks: root.networks;
        scanning <=> root.scanning;
        result-count <=> root.result-count;
        current-page <=> root.wifi-current-page;
        total-pages <=> root.wifi-total-pages;
        status-text <=> root.status-text;
        scan-requested => { root.scan-requested(); }
        swipe-up(dx, dy) => { root.wifi-scroll-up(); }
        swipe-down(dx, dy) => { root.wifi-scroll-down(); }
        swipe-right(dx, dy) => { root.current-app = -1; }
        go-back => { root.current-app = -1; } go-home => { root.current-app = -1; }
    }
    if current-app == 12: ImuPage {
        accel-x <=> root.accel-x;
        accel-y <=> root.accel-y;
        accel-z <=> root.accel-z;
        gyro-x <=> root.gyro-x;
        gyro-y <=> root.gyro-y;
        gyro-z <=> root.gyro-z;
        gesture-debug(msg) => { root.debug(msg); }
        swipe-right(dx, dy) => { root.current-app = -1; }
        go-back => { root.current-app = -1; } go-home => { root.current-app = -1; }
    }
    if current-app == 13: SdCardPage {
        entries: root.sd-entries;
        path-text <=> root.sd-path-text;
        status-text <=> root.sd-status-text;
        total-count <=> root.sd-total-count;
        visible-count <=> root.sd-visible-count;
        scroll-offset <=> root.sd-scroll-offset;
        read-error <=> root.sd-read-error;
        text-open <=> root.sd-text-open;
        text-title <=> root.sd-text-title;
        text-content <=> root.sd-text-content;
        text-page <=> root.sd-text-page;
        total-pages <=> root.sd-total-pages;
        current-page <=> root.sd-current-page;
        entry-selected(index) => { root.sd-entry-selected(index); }
        up-requested => { root.sd-up-requested(); }
        refresh-requested => { root.sd-refresh-requested(); }
        scroll-up => { root.sd-scroll-up(); }
        scroll-down => { root.sd-scroll-down(); }
        close-text => { root.sd-close-text(); }
        previous-text-page => { root.sd-previous-text-page(); }
        next-text-page => { root.sd-next-text-page(); }
        image-open <=> root.sd-image-open;
        image-title <=> root.sd-image-title;
        image-status <=> root.sd-image-status;
        close-image => { root.sd-close-image(); }
        audio-open <=> root.sd-audio-open;
        audio-title <=> root.sd-audio-title;
        audio-size <=> root.sd-audio-size;
        audio-status <=> root.sd-audio-status;
        audio-playing <=> root.sd-audio-playing;
        audio-volume <=> root.audio-volume;
        audio-play => { root.audio-play(); }
        audio-stop => { root.audio-stop(); }
        audio-prev => { root.audio-prev(); }
        audio-next => { root.audio-next(); }
        set-audio-volume(value) => { root.set-audio-volume(value); }
        close-audio => { root.sd-close-audio(); }
        debug(msg) => { root.debug(msg); }
        gesture-debug(msg) => { root.debug(msg); }
        swipe-right(dx, dy) => {
            if root.sd-image-open {
                root.sd-close-image();
            } else if root.sd-audio-open {
                root.sd-close-audio();
            } else if root.sd-text-open {
                root.sd-close-text();
            } else if root.sd-path-text != "/data" {
                root.sd-up-requested();
            } else {
                root.current-app = -1;
            }
        }
        swipe-up(dx, dy) => {
            if root.sd-text-open {
                root.sd-next-text-page();
            } else {
                root.sd-scroll-down();
            }
        }
        swipe-down(dx, dy) => {
            if root.sd-text-open {
                root.sd-previous-text-page();
            } else {
                root.sd-scroll-up();
            }
        }
        go-back => {
            if root.sd-image-open {
                root.sd-close-image();
            } else if root.sd-audio-open {
                root.sd-close-audio();
            } else if root.sd-text-open {
                root.sd-close-text();
            } else if root.sd-path-text != "/data" {
                root.sd-up-requested();
            } else {
                root.current-app = -1;
            }
        }
        go-home => {
            if root.sd-image-open {
                root.sd-close-image();
            } else if root.sd-audio-open {
                root.sd-close-audio();
            } else if root.sd-text-open {
                root.sd-close-text();
            }
            root.current-app = -1;
        }
    }
    if current-app == 14: MetalsPage {
        title: "HTTP GET";
        accent: #5ca9ff;
        time: root.metals-time;
        xau: root.metals-xau;
        xag: root.metals-xag;
        net-status: root.metals-status;
        refreshing <=> root.metals-refreshing;
        refresh => { root.metals-refresh(); }
        swipe-right(dx, dy) => { root.current-app = -1; }
        go-back => { root.current-app = -1; } go-home => { root.current-app = -1; }
    }
    if current-app == 15: AudioPage {
        status-text <=> root.audio-status;
        playing <=> root.audio-playing;
        volume <=> root.audio-volume;
        has-sd-audio <=> root.audio-has-sd-audio;
        track-title <=> root.audio-track-title;
        track-index <=> root.audio-track-index;
        track-count <=> root.audio-track-count;
        audio-play => { root.audio-play(); }
        audio-stop => { root.audio-stop(); }
        audio-prev => { root.audio-prev(); }
        audio-next => { root.audio-next(); }
        set-audio-volume(value) => { root.set-audio-volume(value); }
        swipe-right(dx, dy) => { root.current-app = -1; }
        go-back => { root.current-app = -1; } go-home => { root.current-app = -1; }
    }
    if current-app == 16: TouchPage { go-back => { root.current-app = -1; } go-home => { root.current-app = -1; } }
    if current-app == 17: PowerPage {
        power-off => { root.power-off(); }
        reboot => { root.reboot(); }
        swipe-right(dx, dy) => { root.current-app = -1; }
        go-back => { root.current-app = -1; } go-home => { root.current-app = -1; }
    }
}
