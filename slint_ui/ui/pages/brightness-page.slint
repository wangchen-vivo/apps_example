// Screen brightness control with a horizontal slider.

import { AppPage } from "../components/app-page.slint";
import { Theme } from "../components/theme.slint";

export component BrightnessPage inherits AppPage {
    title: "屏幕亮度";
    accent: #f0bd62;

    in-out property <int> brightness: 100;
    property <int> min-brightness: 30;
    callback set-brightness(int);
    callback commit-brightness(int);

    Text {
        x: 0; y: 76px; width: parent.width; height: 52px;
        text: root.brightness + "%";
        color: root.accent; font-size: 48px; font-weight: 800;
        horizontal-alignment: center; vertical-alignment: center;
    }

    // Horizontal slider: the fill grows from left to right.
    Rectangle {
        x: 80px; y: 158px; width: 320px; height: 64px;
        background: Theme.raised-background;
        border-width: 1px; border-color: Theme.border-color; border-radius: 12px;

        Rectangle {
            x: 0; y: 0;
            width: parent.width * (root.brightness - root.min-brightness) / (100 - root.min-brightness);
            height: parent.height;
            background: root.accent; border-radius: 12px;
        }

        Rectangle {
            x: parent.width * (root.brightness - root.min-brightness) / (100 - root.min-brightness) - 18px;
            y: -10px; width: 36px; height: 84px;
            background: slider-area.pressed ? #ffffff : #f0f0f0;
            border-width: 2px; border-color: root.accent; border-radius: 10px;
        }

        slider-area := TouchArea {
            // Extend the hit area by the knob radius so the 100% and minimum
            // positions remain draggable even when the knob is at an edge.
            x: -18px; width: parent.width + 36px; height: parent.height;
            property <bool> dragging: false;
            property <float> track-px: parent.width / 1px;
            property <float> track-offset: 18.0;

            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    self.dragging = true;
                    root.brightness = clamp(round((self.mouse-x / 1px - self.track-offset) / self.track-px * (100 - root.min-brightness) + root.min-brightness), root.min-brightness, 100);
                    root.set-brightness(root.brightness);
                }
                if event.kind == PointerEventKind.up {
                    self.dragging = false;
                    root.commit-brightness(root.brightness);
                }
            }

            moved => {
                if self.dragging {
                    let next = clamp(round((self.mouse-x / 1px - self.track-offset) / self.track-px * (100 - root.min-brightness) + root.min-brightness), root.min-brightness, 100);
                    if next != root.brightness {
                        root.brightness = next;
                        root.set-brightness(next);
                    }
                }
            }
        }
    }

    // Coarse adjustment buttons remain available below the track.
    Rectangle {
        x: 144px; y: 260px; width: 80px; height: 72px;
        background: minus-area.pressed ? Theme.pressed-background : Theme.raised-background;
        border-width: 1px; border-color: Theme.border-color; border-radius: 14px;
        Text { width: parent.width; height: parent.height; text: "−"; color: root.accent; font-size: Theme.font-lg; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        minus-area := TouchArea { width: parent.width; height: parent.height; clicked => { root.brightness = max(root.brightness - 10, root.min-brightness); root.set-brightness(root.brightness); root.commit-brightness(root.brightness); } }
    }
    Rectangle {
        x: 256px; y: 260px; width: 80px; height: 72px;
        background: plus-area.pressed ? Theme.pressed-background : Theme.raised-background;
        border-width: 1px; border-color: Theme.border-color; border-radius: 14px;
        Text { width: parent.width; height: parent.height; text: "+"; color: root.accent; font-size: Theme.font-lg; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        plus-area := TouchArea { width: parent.width; height: parent.height; clicked => { root.brightness = min(root.brightness + 10, 100); root.set-brightness(root.brightness); root.commit-brightness(root.brightness); } }
    }

    Text {
        x: 0; y: 380px; width: parent.width; height: 24px;
        text: "左右拖动滑块或点击 +/- 调节";
        color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 600;
        horizontal-alignment: center; vertical-alignment: center;
    }
}
