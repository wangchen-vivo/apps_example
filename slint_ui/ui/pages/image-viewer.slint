// PNG image viewer for SD card browser.
// Compatible with SoftwareRenderer::render_by_line: no Path items.

import { Theme } from "../components/theme.slint";

export component ImageViewer inherits Rectangle {
    in property <string> image-title;
    in property <string> image-status;
    callback close-image();

    background: #0b1115;

    // Title bar — left: filename, right: image status
    Text {
        x: 16px; y: 6px; width: 340px; height: 28px;
        text: root.image-title;
        color: Theme.primary-text;
        font-size: Theme.font-base;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: 362px; y: 6px; width: 102px; height: 28px;
        text: root.image-status;
        color: Theme.muted-text;
        font-size: Theme.font-sm;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // Image area background. The PNG itself is drawn by direct framebuffer
    // writes (png_view.rs) starting at page y=102 (below this 40px title
    // row), scaled to fit (contain) and centered with aspect preserved.
    // This rectangle only paints the backdrop behind the title row before
    // the PNG blit lands; PNG_PANEL_* in png_view.rs must stay aligned with
    // this split.
    Rectangle {
        x: 0px; y: 40px; width: parent.width; height: parent.height - 40px;
        background: #05090c;
    }
}