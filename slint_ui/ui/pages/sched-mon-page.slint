// Scheduler and resource monitoring demo page.
// Shows combined CPU + memory monitor, and running task list.
// Content directly on screen-background, no card boxes.

import { AppPage } from "../components/app-page.slint";
import { Theme } from "../components/theme.slint";

export component SchedMonPage inherits AppPage {
    in property <int> cpu-cores: 1;
    in property <[float]> cpu-usage-percent;
    in property <string> cpu-model: "esp32c6";
    in property <string> cpu-isa: "rv32imac";
    in property <string> cpu-mhz-text: "160 MHz";
    in property <float> mem-total-kb: 0.0;
    in property <float> mem-used-kb: 0.0;
    in property <float> mem-max-used-kb: 0.0;
    in property <int> task-hidden: 0;
    in property <int> task-total: 0;
    in property <int> task-page: 1;
    in property <int> task-page-count: 1;
    /// Task table as 5 column strings ("\n"-separated rows each). One Text per
    /// column keeps column alignment to Slint's x layout (no space-padding),
    /// and cuts the scene from 40 Text items to 5 — 40 separate Text elements
    /// were fragmenting the heap and eventually OOM'd on the software
    /// renderer's 14336-byte scene realloc.
    in property <string> task-col-tid: "";
    in property <string> task-col-type: "";
    in property <string> task-col-state: "";
    in property <string> task-col-prio: "";
    in property <string> task-col-name: "";
    callback refresh-tasks();

    title: "CPU与内存";
    accent: #5ca9ff;

    // ====== 监控区块（两列，竖线分隔）======
    // CPU column: x=24..216, Memory column: x=248..440, divider at x=232.

    // ---- CPU column ----
    Text { x: 24px;  y: 76px; width: 60px;  height: 20px; text: "CPU";            color: root.accent;  font-size: Theme.font-base; font-weight: 700; vertical-alignment: center; }
    Text { x: 104px; y: 76px; width: 112px; height: 20px; text: "型号：" + root.cpu-model; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; horizontal-alignment: right; }
    Text { x: 24px;  y: 99px; width: 100px; height: 20px; text: "架构";            color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; }
    Text { x: 124px; y: 99px; width: 92px;  height: 20px; text: root.cpu-isa;      color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; horizontal-alignment: right; }
    Text { x: 24px;  y: 122px; width: 100px; height: 20px; text: "主频";           color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; }
    Text { x: 124px; y: 122px; width: 92px;  height: 20px; text: root.cpu-mhz-text; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; horizontal-alignment: right; }
    Text { x: 24px;  y: 148px; width: 42px;  height: 16px; text: "利用率";          color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; }
    Rectangle {
        x: 72px; y: 151px; width: 100px; height: 10px;
        background: Theme.raised-background; border-radius: 5px;
        Rectangle { x: 0px; y: 0px; width: parent.width * root.cpu-usage-percent[0] / 100.0; height: 10px; background: root.accent; border-radius: 5px; }
    }
    Text { x: 176px; y: 148px; width: 40px; height: 16px; text: Math.clamp(Math.round(root.cpu-usage-percent[0]), 0, 100) + "%"; color: root.accent; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; horizontal-alignment: right; }

    // ---- Divider ----
    Rectangle { x: 232px; y: 76px; width: 1px; height: 96px; background: Theme.divider-color; }

    // ---- Memory column ----
    Text { x: 248px; y: 76px;  width: 60px;  height: 20px; text: "内存";                              color: #f0bd62;       font-size: Theme.font-base; font-weight: 700; vertical-alignment: center; }
    Text { x: 328px; y: 76px;  width: 112px; height: 20px; text: "总计：" + root.mem-total-kb + " kB"; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; horizontal-alignment: right; }
    Text { x: 248px; y: 99px;  width: 100px; height: 20px; text: "已用";                              color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; }
    Text { x: 348px; y: 99px;  width: 92px;  height: 20px; text: root.mem-used-kb + " kB";          color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; horizontal-alignment: right; }
    Text { x: 248px; y: 122px; width: 100px; height: 20px; text: "峰值";                              color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; }
    Text { x: 348px; y: 122px; width: 92px;  height: 20px; text: root.mem-max-used-kb + " kB";      color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; horizontal-alignment: right; }
    Text { x: 248px; y: 148px; width: 42px;  height: 16px; text: "使用率";                            color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; }
    Rectangle {
        x: 296px; y: 151px; width: 100px; height: 10px;
        background: Theme.raised-background; border-radius: 5px;
        Rectangle { x: 0px; y: 0px; width: parent.width * (root.mem-total-kb > 0 ? root.mem-used-kb / root.mem-total-kb : 0); height: 10px; background: #f0bd62; border-radius: 5px; }
    }
    Text { x: 400px; y: 148px; width: 40px; height: 16px; text: (root.mem-total-kb > 0 ? Math.clamp(Math.round(root.mem-used-kb / root.mem-total-kb * 100), 0, 100) : 0) + "%"; color: #f0bd62; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; horizontal-alignment: right; }

    // ====== 任务列表区块 ======
    Rectangle { x: 24px; y: 182px; width: 6px; height: 18px; background: #86efac; border-radius: 3px; }
    Text { x: 38px; y: 178px; width: 200px; height: 26px; text: "任务列表"; color: #86efac; font-size: Theme.font-base; font-weight: 700; vertical-alignment: center; }
    Text { x: 130px; y: 182px; width: 100px; height: 22px; text: root.task-page + "/" + root.task-page-count + " 页"; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; }

    // Column headers (absolute x = 24 + relative x):
    //   TID 0/40  类型 42/56  状态 100/80  优先级 182/40  名称 224/172
    Text { x: 24px;  y: 212px; width: 40px;  height: 20px; text: "TID";    color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 72px;  y: 212px; width: 56px;  height: 20px; text: "类型";   color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 130px; y: 212px; width: 80px;  height: 20px; text: "状态";   color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 216px; y: 212px; width: 56px;  height: 20px; text: "优先级"; color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 284px; y: 212px; width: 148px; height: 20px; text: "名称";   color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }

    // Task rows — one Text per column, each column is an 8-line string
    // ("\n"-separated rows built in Rust). Column x-positions come from Slint
    // layout so values align regardless of font advance widths. 5 Text items
    // total (vs 40 cells) keeps the software renderer's scene allocation low.
    Text { x: 24px;  y: 234px; width: 40px;  height: 176px; text: root.task-col-tid;   color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: top; wrap: no-wrap; overflow: elide; }
    Text { x: 72px;  y: 234px; width: 56px;  height: 176px; text: root.task-col-type;  color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: top; wrap: no-wrap; overflow: elide; }
    Text { x: 130px; y: 234px; width: 80px;  height: 176px; text: root.task-col-state; color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: top; wrap: no-wrap; overflow: elide; }
    Text { x: 216px; y: 234px; width: 56px;  height: 176px; text: root.task-col-prio;  color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: top; wrap: no-wrap; overflow: elide; }
    Text { x: 284px; y: 234px; width: 148px; height: 176px; text: root.task-col-name;  color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: top; wrap: no-wrap; overflow: elide; }
}
