// Standalone preview for sched-mon-page layout with placeholder task data.
// Run: slint-viewer ui/pages/sched-mon-preview.slint

import { Theme } from "../components/theme.slint";

export component SchedMonPreview inherits Window {
    width: 480px;
    height: 480px;
    background: Theme.screen-background;
    default-font-family: Theme.text-font-family;

    // ====== placeholder data ======
    property <string> page-title: "调度与监控";
    property <color> accent: #5ca9ff;

    property <float> cpu-pct: 42.0;
    property <string> cpu-model: "esp32c6";
    property <string> cpu-isa: "rv32imac";
    property <string> cpu-mhz-text: "160 MHz";
    property <float> mem-total-kb: 320.0;
    property <float> mem-used-kb: 168.0;
    property <float> mem-max-kb: 210.0;

    property <int> task-hidden: 5; // tasks below the visible window

    // 7 visible rows × 5 columns of placeholder data
    property <[string]> task-tids: ["01FF","02A1","03C4","04BD","05EE","0617","0728","0839"];
    property <[string]> task-types: ["norm","timer","poll","idle","norm","norm","poll","timer"];
    property <[string]> task-states: ["RUNNING","READY","SUSPENDED","IDLE","READY","SUSPENDED","READY","READY"];
    property <[string]> task-prios: ["120","200","150","0","120","120","150","200"];
    property <[string]> task-names: ["slint_ui_task","soft_timer","async_poller","Idle Task","blueos_core","led_blink"];

    // ====== Title bar ======
    Rectangle {
        x: 0; y: 0; width: parent.width; height: 60px;
        background: Theme.surface-background;
        Text {
            x: 0; width: parent.width; height: parent.height;
            text: root.page-title;
            color: Theme.primary-text;
            font-size: Theme.font-lg;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle { x: 0; y: 59px; width: parent.width; height: 1px; background: Theme.divider-color; }
    }

    // ====== 监控区块（对齐 HTML 设计稿坐标）======
    // Monitor block: y=76..172, two columns split by divider at x=232.
    // CPU column: x=24, content right edge 216.
    // Memory column: x=265, content right edge 457.

    // ---- CPU column ----
    // col-title: y=76, label left + model right
    Text { x: 24px; y: 76px; width: 60px; height: 20px; text: "CPU"; color: root.accent; font-size: Theme.font-base; font-weight: 700; vertical-alignment: center; }
    Text { x: 104px; y: 76px; width: 112px; height: 20px; text: "型号：" + root.cpu-model; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; horizontal-alignment: right; }
    // info-row 1 (架构): y=99
    Text { x: 24px; y: 99px; width: 100px; height: 20px; text: "架构"; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; }
    Text { x: 124px; y: 99px; width: 92px; height: 20px; text: root.cpu-isa; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; horizontal-alignment: right; }
    // info-row 2 (主频): y=122
    Text { x: 24px; y: 122px; width: 100px; height: 20px; text: "主频"; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; }
    Text { x: 124px; y: 122px; width: 92px; height: 20px; text: root.cpu-mhz-text; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; horizontal-alignment: right; }
    // bar-row (利用率): y=148, pushed to bottom of 96px block
    Text { x: 24px; y: 148px; width: 42px; height: 16px; text: "利用率"; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; }
    Rectangle {
        x: 72px; y: 151px; width: 100px; height: 10px;
        background: Theme.raised-background; border-radius: 5px;
        Rectangle { x: 0px; y: 0px; width: parent.width * root.cpu-pct / 100.0; height: 10px; background: root.accent; border-radius: 5px; }
    }
    Text { x: 176px; y: 148px; width: 40px; height: 16px; text: root.cpu-pct + "%"; color: root.accent; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; horizontal-alignment: right; }

    // ---- Divider ----
    Rectangle { x: 232px; y: 76px; width: 1px; height: 96px; background: Theme.divider-color; }

    // ---- Memory column ----
    // col-title: y=76
    Text { x: 248px; y: 76px; width: 60px; height: 20px; text: "内存"; color: #f0bd62; font-size: Theme.font-base; font-weight: 700; vertical-alignment: center; }
    Text { x: 328px; y: 76px; width: 112px; height: 20px; text: "总计：" + root.mem-total-kb + " kB"; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; horizontal-alignment: right; }
    // info-row 1 (已用): y=99
    Text { x: 248px; y: 99px; width: 100px; height: 20px; text: "已用"; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; }
    Text { x: 348px; y: 99px; width: 92px; height: 20px; text: root.mem-used-kb + " kB"; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; horizontal-alignment: right; }
    // info-row 2 (峰值): y=122
    Text { x: 248px; y: 122px; width: 100px; height: 20px; text: "峰值"; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; }
    Text { x: 348px; y: 122px; width: 92px; height: 20px; text: root.mem-max-kb + " kB"; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; horizontal-alignment: right; }
    // bar-row (使用率): y=148
    Text { x: 248px; y: 148px; width: 42px; height: 16px; text: "使用率"; color: Theme.muted-text; font-size: Theme.font-sm; vertical-alignment: center; }
    Rectangle {
        x: 296px; y: 151px; width: 100px; height: 10px;
        background: Theme.raised-background; border-radius: 5px;
        Rectangle { x: 0px; y: 0px; width: parent.width * (root.mem-used-kb / root.mem-total-kb); height: 10px; background: #f0bd62; border-radius: 5px; }
    }
    Text { x: 400px; y: 148px; width: 40px; height: 16px; text: Math.round(root.mem-used-kb / root.mem-total-kb * 100) + "%"; color: #f0bd62; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; horizontal-alignment: right; }

    // ====== 任务列表区块 ======
    Rectangle { x: 24px; y: 182px; width: 6px; height: 18px; background: #86efac; border-radius: 3px; }
    Text { x: 38px; y: 178px; width: 200px; height: 26px; text: "任务列表"; color: #86efac; font-size: Theme.font-base; font-weight: 700; vertical-alignment: center; }
    // Page indicator next to the "任务列表" label.
    Text {
        x: 130px; y: 182px; width: 80px; height: 22px;
        text: "1-8/12 项";
        color: Theme.muted-text; font-size: Theme.font-sm;
        vertical-alignment: center;
    }

    // Column headers (absolute x = 24 + relative x):
    //   TID 0/40  类型 42/56  状态 100/80  优先级 182/40  名称 224/208
    Text { x: 24px;  y: 212px; width: 40px;  height: 20px; text: "TID";    color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 72px;  y: 212px; width: 56px;  height: 20px; text: "类型";   color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 130px; y: 212px; width: 80px;  height: 20px; text: "状态";   color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 216px; y: 212px; width: 56px;  height: 20px; text: "优先级"; color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }
    Text { x: 284px; y: 212px; width: 148px; height: 20px; text: "名称";   color: Theme.muted-text; font-size: Theme.font-sm; font-weight: 700; vertical-alignment: center; }

    // 7 visible rows, 22px each (254..408).
    for idx in 8 : Rectangle {
        x: 24px; y: 234px + idx * 22px;
        width: 432px; height: 20px;

        Text { x: 0px;   width: 40px;  height: parent.height; text: root.task-tids[idx];   color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; }
        Text { x: 48px;  width: 56px;  height: parent.height; text: root.task-types[idx];  color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; }
        Text { x: 106px; width: 80px;  height: parent.height; text: root.task-states[idx]; color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; }
        Text { x: 192px; width: 56px;  height: parent.height; text: root.task-prios[idx];  color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; }
        Text { x: 260px; width: 172px; height: parent.height; text: root.task-names[idx];  color: Theme.secondary-text; font-size: Theme.font-sm; font-weight: 600; vertical-alignment: center; overflow: elide; }
    }

    // Page indicator moved to the title row above.


    // ====== Bottom nav (static, non-interactive) ======
    Rectangle {
        x: 0; y: parent.height - 56px; width: parent.width; height: 56px;
        background: Theme.surface-background;
        Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: Theme.divider-color; }
        Text { x: 0; width: 240px; height: parent.height; text: "主页"; color: Theme.primary-text; font-size: Theme.font-base; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Text { x: 240px; width: 240px; height: parent.height; text: "返回"; color: Theme.primary-text; font-size: Theme.font-base; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
        Rectangle { x: 239px; y: 8px; width: 1px; height: 40px; background: Theme.divider-color; }
    }
}
