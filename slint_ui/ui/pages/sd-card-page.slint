// SD card browser integrated into the launcher.
// Compatible with SoftwareRenderer::render_by_line: no Path items.

import { AppPage } from "../components/app-page.slint";
import { Theme } from "../components/theme.slint";
import { TextViewer } from "text-viewer.slint";
import { ImageViewer } from "image-viewer.slint";
import { AudioViewer } from "audio-viewer.slint";

export struct SdFileEntry {
    name: string,
    is-dir: bool,
    can-open: bool,
    is-image: bool,
    is-audio: bool,
    size-text: string,
}

export component SdCardPage inherits AppPage {
    title: "SD 卡";
    accent: #f0bd62;

    in property <[SdFileEntry]> entries;
    in-out property <string> path-text: "/data";
    in-out property <string> status-text: "";
    in-out property <int> total-count: 0;
    in-out property <int> visible-count: 0;
    in-out property <int> scroll-offset: 0;
    in-out property <bool> read-error: false;
    // Entries per page (must match MAX_VISIBLE_ENTRIES in Rust)
    property <int> page-size: 5;
    in-out property <int> total-pages: 0;
    in-out property <int> current-page: 0;
    // Text viewer
    in-out property <bool> text-open: false;
    in-out property <string> text-title: "";
    in-out property <string> text-content: "";
    in-out property <string> text-page: "";
    // PNG image viewer
    in-out property <bool> image-open: false;
    in-out property <string> image-title: "";
    in-out property <string> image-status: "";
    // WAV audio viewer state — separate from the audio page's audio-* set.
    // The player engine (I2S handle, volume) is shared, but playback status
    // and progress are tracked per-entry so neither view disturbs the other.
    in-out property <bool> audio-open: false;
    in-out property <string> audio-title: "";
    // File size while idle, then playback progress routed by the audio module.
    in-out property <string> audio-status: "";
    // Playback state of the SD-card WAV source (routed by audio.rs).
    in-out property <bool> audio-playing: false;
    in property <string> main-audio-status;
    // Shared codec volume, bound to MainWindow's audio-volume by main.slint.
    in-out property <int> audio-volume: 100;
    callback audio-play();
    callback audio-stop();
    callback set-audio-volume(int);
    // Currently pressed row index (-1 = none). Highlighted with an accent border.
    property <int> pressed-index: -1;

    callback entry-selected(int);
    callback up-requested();
    callback refresh-requested();
    callback scroll-up();
    callback scroll-down();
    callback close-text();
    callback previous-text-page();
    callback next-text-page();
    callback close-image();
    callback close-audio();
    callback debug(string);

    // Dynamic bottom nav labels
    property <bool> viewer-open: root.text-open || root.image-open || root.audio-open;
    property <bool> is-top-level: root.path-text == "/data";
    nav-back-text: root.viewer-open ? "退出" : root.is-top-level ? "返回" : "上一层";
    nav-home-text: root.is-top-level || root.viewer-open ? "主页" : "主页";

    // Path bar — left: path, right: item count
    if !root.viewer-open: Rectangle {
        x: 16px;
        y: 74px;
        width: 448px;
        height: 34px;

        Text {
            x: 0;
            width: 350px;
            height: parent.height;
            text: root.path-text;
            color: Theme.secondary-text;
            font-size: Theme.font-sm;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: 352px;
            width: 96px;
            height: parent.height;
            text: root.total-count > 0 ? root.current-page + "/" + root.total-pages : "";
            color: Theme.muted-text;
            font-size: Theme.font-sm;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    // Empty state
    if !root.viewer-open && root.total-count == 0: Rectangle {
        x: 0; y: 120px; width: parent.width; height: 250px;

        Text {
            y: 80px;
            width: parent.width;
            height: 50px;
            text: root.read-error ? "SD 不可用" : "空目录";
            color: root.read-error ? #f08091 : Theme.muted-text;
            font-size: Theme.font-lg;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // File list
    for entry[index] in root.entries: Rectangle {
        x: 16px;
        y: 124px + index * 56px;
        width: 448px;
        height: 52px;
        visible: !root.viewer-open;

        Rectangle {
            x: 8px;
            y: 10px;
            width: 32px;
            height: 32px;
            background: entry.is-dir ? #284d42 : entry.is-image ? #3b405f : entry.is-audio ? #4f2f5f : Theme.raised-background;
            border-radius: 8px;
            Text {
                width: parent.width;
                height: parent.height;
                text: entry.is-dir ? "D" : entry.is-image ? "P" : entry.is-audio ? "A" : entry.can-open ? "T" : "F";
                color: entry.is-dir ? #6fe0bd : entry.is-image ? #aab5ff : entry.is-audio ? #d9a6ff : Theme.secondary-text;
                font-size: Theme.font-sm;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            x: 48px;
            y: 4px;
            width: 400px;
            height: 26px;
            text: entry.name;
            color: Theme.primary-text;
            font-size: Theme.font-base;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            x: 48px;
            y: 28px;
            width: 400px;
            height: 20px;
            text: entry.is-dir ? "目录" : entry.size-text + (entry.is-image ? "  PNG" : entry.is-audio ? "  WAV" : entry.can-open ? "  文本" : "");
            color: Theme.muted-text;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
    }

    // Pressed-row highlight overlay — declared after the list so it renders
    // on top of row content. Kept outside the for-repeater so changing
    // pressed-index only dirties this one rectangle, not every row.
    // Transparent fill: only the accent border highlights, content shows through.
    if root.pressed-index >= 0 && !root.viewer-open: Rectangle {
        x: 16px;
        y: 124px + root.pressed-index * 56px;
        width: 448px;
        height: 52px;
        border-width: 2px;
        border-radius: 8px;
        border-color: root.accent;
        background: transparent;
    }

    // Tap handler — the full-screen GestureLayer delivers tap coordinates
    // here. Map the y coordinate to a visible row and open that entry.
    // Rows start at y=124px with 56px spacing, x spans 16..464px.
    tap(mx, my) => {
        root.debug("SD tap mx=" + mx + " my=" + my);
        if !root.viewer-open && root.total-count > 0 {
            if mx >= 16.0 && mx < 464.0 && my >= 124.0 && my < 124.0 + root.visible-count * 56.0 {
                let index = (my - 124.0) / 56.0;
                root.debug("SD tap -> entry " + index);
                root.entry-selected(index);
            }
        }
    }

    // Press/release highlight — down on a row highlights its border.
    press(mx, my) => {
        if !root.viewer-open && root.total-count > 0 {
            if mx >= 16.0 && mx < 464.0 && my >= 124.0 && my < 124.0 + root.visible-count * 56.0 {
                root.pressed-index = (my - 124.0) / 56.0;
            }
        }
    }
    release() => {
        root.pressed-index = -1;
    }

    // Pagination via swipe-up/down only — no buttons

    // Text viewer
    if root.text-open: TextViewer {
        x: 0px;
        y: 62px;
        width: parent.width;
        height: parent.height - 62px - 56px;
        text-title: root.text-title;
        text-content: root.text-content;
        text-page: root.text-page;
        close-text => { root.close-text(); }
    }

    // PNG image viewer
    if root.image-open: ImageViewer {
        x: 0px;
        y: 62px;
        width: parent.width;
        height: parent.height - 62px - 56px;
        image-title: root.image-title;
        image-status: root.image-status;
        close-image => { root.close-image(); }
    }

    // WAV audio viewer — pixel-identical controls to the audio page
    // (hero card / play-stop buttons / volume slider), but driven by the
    // SD-card player state (sd-audio-*), independent from the audio page.
    if root.audio-open: AudioViewer {
        x: 0px;
        y: 62px;
        width: parent.width;
        height: parent.height - 62px - 56px;
        audio-title: root.audio-title;
        audio-status-size: root.audio-status;
        audio-status: root.main-audio-status;
        audio-playing: root.audio-playing;
        volume <=> root.audio-volume;
        audio-play => { root.audio-play(); }
        audio-stop => { root.audio-stop(); }
        set-audio-volume(value) => { root.set-audio-volume(value); }
    }
}